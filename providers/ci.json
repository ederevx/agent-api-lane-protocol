{
  "id": "ci",
  "display_name": "CheapestInference",
  "endpoint": "https://api.cheapestinference.com/anthropic",
  "concurrency_limit": 1,
  "client": "python-http.client",
  "active": true,
  "request_shape": {
    "paths": ["/v1/messages", "/v1/messages/count_tokens"],
    "passthrough": true,
    "auth_header": "Authorization",
    "auth_scheme": "Bearer"
  },
  "timeout_overrides": {
    "total_timeout_seconds": 3600
  }
}
